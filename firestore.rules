rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 4 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidLeaderboardEntry(data, studentId) {
      return data.keys().hasAll([
          'studentId',
          'nickname',
          'score',
          'stars',
          'solvedCount',
          'clearedStages',
          'bestAccuracy',
          'playTimeSeconds',
          'isPublic',
          'classCode',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'studentId',
          'nickname',
          'score',
          'stars',
          'solvedCount',
          'clearedStages',
          'bestAccuracy',
          'playTimeSeconds',
          'isPublic',
          'classCode',
          'createdAt',
          'updatedAt'
        ])
        && data.studentId is string
        && data.studentId == studentId
        && isValidId(data.studentId)
        && data.nickname is string
        && data.nickname.size() >= 1
        && data.nickname.size() <= 20
        && data.score is int
        && data.score >= 0
        && data.score <= 1000000
        && data.stars is int
        && data.stars >= 0
        && data.stars <= 10000
        && data.solvedCount is int
        && data.solvedCount >= 0
        && data.solvedCount <= 50000
        && data.clearedStages is int
        && data.clearedStages >= 0
        && data.clearedStages <= 3
        && data.bestAccuracy is int
        && data.bestAccuracy >= 0
        && data.bestAccuracy <= 100
        && data.playTimeSeconds is int
        && data.playTimeSeconds >= 0
        && data.playTimeSeconds <= 8640000
        && data.isPublic is bool
        && data.isPublic == true
        && data.classCode is string
        && data.classCode == '2026'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /leaderboard/{studentId} {
      allow get: if isValidId(studentId) && (resource == null || existing().isPublic == true);
      allow list: if existing().isPublic == true;

      allow create: if isValidId(studentId)
        && isValidLeaderboardEntry(incoming(), studentId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(studentId)
        && isValidLeaderboardEntry(incoming(), studentId)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'score',
          'stars',
          'solvedCount',
          'clearedStages',
          'bestAccuracy',
          'playTimeSeconds',
          'updatedAt'
        ])
        && incoming().studentId == existing().studentId
        && incoming().nickname == existing().nickname
        && incoming().classCode == existing().classCode
        && incoming().isPublic == existing().isPublic
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().score >= existing().score
        && incoming().stars >= existing().stars
        && incoming().solvedCount >= existing().solvedCount
        && incoming().clearedStages >= existing().clearedStages
        && incoming().bestAccuracy >= existing().bestAccuracy
        && (!('playTimeSeconds' in existing()) || incoming().playTimeSeconds >= existing().playTimeSeconds);

      allow delete: if false;
    }
  }
}
